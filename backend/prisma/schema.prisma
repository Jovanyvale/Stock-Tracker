generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Simulation {
  id            String   @id @default(uuid())
  symbol        String   @db.VarChar(20)
  amount        Decimal  @db.Decimal(12, 2)
  range         String   @db.VarChar(10)
  startDate     DateTime
  endDate       DateTime
  startPrice    Decimal  @db.Decimal(12, 4)
  endPrice      Decimal  @db.Decimal(12, 4)
  sharesBought  Decimal  @db.Decimal(16, 8)
  currentValue  Decimal  @db.Decimal(14, 2)
  profit        Decimal  @db.Decimal(14, 2)
  profitPercent Decimal  @db.Decimal(8, 2)
  createdAt     DateTime @default(now())

  @@index([symbol])
  @@index([createdAt])
  @@map("simulations")
}